# Copy to .env for local runs. Never commit .env.
PORT=4000
# MongoDB Atlas connection string (free M0 cluster) or local mongodb://127.0.0.1:27017/afn
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/afn-rent-a-car
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# The admin account is created/updated from these on start (use a strong password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Comma-separated list of sites allowed to call the API (the Vercel URL and local Vite)
CORS_ORIGINS=https://<your-project>.vercel.app,http://localhost:5173
# Fill empty collections with the demo fleet on start (default true)
SEED_ON_START=true
# Optional rate limits (per IP): login/sign-up per 15 min, bookings/contact per 10 min
AUTH_RATE_LIMIT=10
PUBLIC_WRITE_LIMIT=20
